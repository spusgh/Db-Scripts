    "closingDate": { "bsonType": "date" },
    "applicationFee": { "bsonType": ["double", "decimal"] },
    "dti": { "bsonType": ["double", "decimal"] },
    "propertyValue": { "bsonType": ["double", "decimal"] },
    "ltv": { "bsonType": ["double", "decimal"] },
    "rateOffered": { "bsonType": ["double", "decimal"] },
